+/* LOT A — surfaces translucides.
+   Ces trois fonds étaient des rgba() quasi blancs : ils échappaient aux
+   variables par couleur et seraient restés clairs en mode sombre.
+   Les valeurs claires sont les rgba() d'origine à l'identique. */
+:root {
+  --surf-sticky-83: rgba(250, 249, 245, .83);
+  --surf-sticky-94: rgba(250, 249, 245, .94);
+  --surf-pill-70: rgba(255, 255, 255, .7);
+}
+.dark {
+  --surf-sticky-83: rgba(23, 23, 23, .83);
+  --surf-sticky-94: rgba(23, 23, 23, .94);
+  --surf-pill-70: rgba(23, 23, 23, .7);
+}
